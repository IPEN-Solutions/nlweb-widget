# Agentic coding credential classification template.
# Copy to .env.agentic.coding locally; never commit the populated file.

# OpenAI / Codex-compatible API
OPENAI_API_KEY=

# Anthropic / Claude-compatible API
ANTHROPIC_API_KEY=

# Other coding-agent provider API keys, if used by local tooling
# CODE_AGENT_API_KEY=

# GitHub CLI / API authentication should normally remain in the user's
# OS credential store or `gh auth`; do not copy a personal token here.
# GITHUB_TOKEN=

# Optional package/release credentials should use CI trusted publishing instead.
# PYPI_TOKEN=
