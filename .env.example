# Core
# Disabled by default: protects a fresh domain from accidental projection/retrieval.
NLWEB_ENABLED=false
NLWEB_PREFIX=/nlweb
NLWEB_SITE=default
NLWEB_RETRIEVAL_STORE=memory
# Optional Haystack InMemory semantic retrieval
# NLWEB_RETRIEVAL_STORE=haystack-memory
NLWEB_CONTENT_SYNC_ENABLED=true
NLWEB_CONTENT_SYNC_ON_STARTUP=false
NLWEB_CONTENT_SOURCES_FILE=./nlweb-sources.json
NLWEB_CONTENT_SYNC_STATE_FILE=.nlweb-sync-state.json
NLWEB_CONTENT_SYNC_INTERVAL_SECONDS=900

# Optional PostgreSQL + pgvector
# NLWEB_RETRIEVAL_STORE=pgvector
# NLWEB_POSTGRES_DATABASE_URL=postgresql+asyncpg://nlweb:nlweb@localhost:5432/nlweb
# NLWEB_PGVECTOR_DIMENSIONS=384

# Optional Neo4j
# NLWEB_RETRIEVAL_STORE=neo4j
# NLWEB_NEO4J_URI=neo4j://localhost:7687
# NLWEB_NEO4J_USERNAME=neo4j
# NLWEB_NEO4J_PASSWORD=
# NLWEB_NEO4J_DATABASE=neo4j
# NLWEB_NEO4J_VECTOR_DIMENSIONS=384

# Optional Qdrant Server / Cloud
# NLWEB_RETRIEVAL_STORE=qdrant
# NLWEB_QDRANT_URL=http://localhost:6333
# NLWEB_QDRANT_API_KEY=
# NLWEB_QDRANT_COLLECTION=nlweb_documents
# NLWEB_QDRANT_DIMENSIONS=384

# Optional Qdrant Edge (embedded/local, no server required)
# NLWEB_RETRIEVAL_STORE=qdrant_edge
# NLWEB_QDRANT_EDGE_PATH=./.nlweb-qdrant-edge
# NLWEB_QDRANT_EDGE_DIMENSIONS=384

# Optional SQLite + sqlite-vec hybrid retrieval (FTS5 + vector KNN)
# Install with: uv sync --extra sqlite
# NLWEB_RETRIEVAL_STORE=sqlite
# NLWEB_SQLITE_PATH=./.nlweb-sqlite/nlweb.db
# NLWEB_SQLITE_DIMENSIONS=384

# Optional local semantic embeddings (used by Haystack/Qdrant/PostgreSQL/Neo4j when
# an embedding provider is not injected). The default is multilingual and light enough
# for local development. For E5 models, query/passage prefixes are applied automatically.
# NLWEB_EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
# NLWEB_EMBEDDING_QUERY_PREFIX=
# NLWEB_EMBEDDING_DOCUMENT_PREFIX=
# NLWEB_EMBEDDING_DEVICE=cpu

# Optional unstructured document ingestion via Docling for ContentSourceKind.CUSTOM.
# Install with: uv sync --extra documents
